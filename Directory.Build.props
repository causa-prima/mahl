<Project>
	<PropertyGroup>
		<LangVersion>latest</LangVersion>
		<Nullable>enable</Nullable>
		<WarningsAsErrors>Nullable</WarningsAsErrors>
		<TreatWarningsAsErrors>true</TreatWarningsAsErrors>
		<AnalysisMode>All</AnalysisMode>
		<!-- Abhängigkeiten explizit: Ein Projekt sieht nur, was es selbst referenziert. Dieser Schalter
		     betrifft nur Projekt-Referenzen; Pakete aus anderen Projekten blendet PrivateAssets=compile unten
		     aus, Paket-zu-Paket-Abhängigkeiten der Target CompileOnlyAgainstDirectPackages in
		     Directory.Build.targets. -->
		<DisableTransitiveProjectReferences>true</DisableTransitiveProjectReferences>
	</PropertyGroup>

	<!-- PrivateAssets ersetzt den NuGet-Standard contentfiles;analyzers;build, statt ihn zu ergänzen –
	     deshalb steht er hier vollständig, nur um compile erweitert. -->
	<ItemDefinitionGroup>
		<PackageReference>
			<PrivateAssets>compile;contentfiles;analyzers;build</PrivateAssets>
		</PackageReference>
	</ItemDefinitionGroup>
</Project>
