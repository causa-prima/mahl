{
  "permissions": {
    "allow": [
      "Edit(Server/**/*.cs)",
      "Edit(Server.Tests/**/*.cs)",
      "Edit(Infrastructure/**/*.cs)",
      "Edit(Client/src/**/*.ts)",
      "Edit(Client/src/**/*.tsx)",
      "Edit(Client/src/**/*.css)",
      "Edit(Client/e2e/**/*.ts)"
    ]
  },
  "hooks": {
    "SessionStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "cd \"$CLAUDE_PROJECT_DIR\" && python3 -m prozesscode.session-agenda --block verhalten"
          },
          {
            "type": "command",
            "command": "cd \"$CLAUDE_PROJECT_DIR\" && python3 -m prozesscode.session-agenda --block doku"
          },
          {
            "type": "command",
            "command": "cd \"$CLAUDE_PROJECT_DIR\" && python3 -m prozesscode.session-agenda --block kommunikation"
          },
          {
            "type": "command",
            "command": "cd \"$CLAUDE_PROJECT_DIR\" && python3 -m prozesscode.session-agenda --block bash-allowlist"
          },
          {
            "type": "command",
            "command": "cd \"$CLAUDE_PROJECT_DIR\" && python3 -m prozesscode.session-agenda --block agenda"
          },
          {
            "type": "command",
            "command": "cd \"$CLAUDE_PROJECT_DIR\" && python3 -m prozesscode.user-message"
          }
        ]
      }
    ],
    "PreToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "cd \"$CLAUDE_PROJECT_DIR\" && python3 -m prozesscode.hooks.check-bash-permission"
          }
        ]
      },
      {
        "matcher": "Edit|Write",
        "hooks": [
          {
            "type": "command",
            "command": "cd \"$CLAUDE_PROJECT_DIR\" && python3 -m prozesscode.hooks.dispatch-edit-write"
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "Edit|Write",
        "hooks": [
          {
            "type": "command",
            "command": "cd \"$CLAUDE_PROJECT_DIR\" && python3 -m prozesscode.hooks.check-code-quality-nonblocking"
          }
        ]
      }
    ]
  },
  "enabledPlugins": {
    "typescript-lsp@claude-plugins-official": true
  }
}
