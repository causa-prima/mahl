{
  "minTokens": 70,
  "format": ["typescript", "tsx", "csharp", "python"],
  "path": [
    "Client/src",
    "Server",
    "Infrastructure",
    "prozesscode",
    "tests"
  ],
  "ignore": [
    "**/node_modules/**",
    "**/bin/**",
    "**/obj/**",
    "**/dist/**",
    "**/__pycache__/**",
    "Client/src/**/*.test.ts",
    "Client/src/**/*.test.tsx",
    "Client/src/**/*.spec.ts",
    "Client/src/**/*.spec.tsx",
    "Client/e2e/**",
    "Infrastructure/Migrations/**"
  ],
  "reporters": ["console"]
}
