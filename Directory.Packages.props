<Project>
	<!-- Zentrale Paketverwaltung: Jede Paketversion steht nur hier. Die .csproj-Dateien referenzieren
	     Pakete ohne Version. Neue Pakete: Prozess in docs/reference/dependencies.md. -->
	<PropertyGroup>
		<ManagePackageVersionsCentrally>true</ManagePackageVersionsCentrally>
		<!-- EF Core, Relational und Design müssen dieselbe Version haben: Abweichende Stände bauen grün,
		     scheitern aber zur Laufzeit mit "Could not load file or assembly 'Microsoft.EntityFrameworkCore'". -->
		<EntityFrameworkCoreVersion>10.0.5</EntityFrameworkCoreVersion>
	</PropertyGroup>

	<!-- Analyzer für alle Projekte; GlobalPackageReference setzt PrivateAssets=all selbst. -->
	<ItemGroup>
		<GlobalPackageReference Include="SonarAnalyzer.CSharp" Version="10.22.0.136894" />
		<GlobalPackageReference Include="Meziantou.Analyzer" Version="3.0.43" />
	</ItemGroup>

	<ItemGroup>
		<PackageVersion Include="Microsoft.EntityFrameworkCore" Version="$(EntityFrameworkCoreVersion)" />
		<PackageVersion Include="Microsoft.EntityFrameworkCore.Relational" Version="$(EntityFrameworkCoreVersion)" />
		<PackageVersion Include="Microsoft.EntityFrameworkCore.Design" Version="$(EntityFrameworkCoreVersion)" />
		<PackageVersion Include="Npgsql" Version="10.0.2" />
		<PackageVersion Include="Npgsql.EntityFrameworkCore.PostgreSQL" Version="10.0.1" />

		<PackageVersion Include="Microsoft.AspNetCore.OpenApi" Version="10.0.5" />
		<!-- Security-Pin (CVE-2026-49451): AspNetCore.OpenApi fordert noch 2.0.0. Entfernen, sobald
		     AspNetCore.OpenApi eine Version >= 2.7.5 referenziert. -->
		<PackageVersion Include="Microsoft.OpenApi" Version="2.7.5" />
		<PackageVersion Include="OneOf" Version="3.0.271" />

		<PackageVersion Include="AwesomeAssertions" Version="9.4.0" />
		<PackageVersion Include="coverlet.MTP" Version="10.0.1" />
		<PackageVersion Include="Microsoft.AspNetCore.Mvc.Testing" Version="10.0.5" />
		<PackageVersion Include="Microsoft.NET.Test.Sdk" Version="18.3.0" />
		<PackageVersion Include="Testcontainers.PostgreSql" Version="4.15.0" />
		<PackageVersion Include="xunit.runner.visualstudio" Version="3.1.5" />
		<PackageVersion Include="xunit.v3.mtp-v2" Version="3.2.2" />
	</ItemGroup>
</Project>
