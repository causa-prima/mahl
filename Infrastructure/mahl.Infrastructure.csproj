<Project Sdk="Microsoft.NET.Sdk">

    <PropertyGroup>
        <TargetFramework>net10.0</TargetFramework>
        <ImplicitUsings>enable</ImplicitUsings>
    </PropertyGroup>

    <ItemGroup>
        <PackageReference Include="Microsoft.EntityFrameworkCore" />
        <PackageReference Include="Microsoft.EntityFrameworkCore.Relational" />
        <PackageReference Include="Npgsql.EntityFrameworkCore.PostgreSQL" />
    </ItemGroup>

    <ItemGroup>
        <IndirectCompileReference Include="Microsoft.EntityFrameworkCore.Abstractions"
            Reason="Von dotnet ef generierter Migrations-/Snapshot-Code nutzt DeleteBehavior für
                    Fremdschlüssel (CS0012/CS0103); der eigene Code referenziert das Paket nicht." />
    </ItemGroup>

</Project>